{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Launcher Minecraft",
  "version": "0.1.0",
  "identifier": "dev.launcher.minecraft",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Launcher Minecraft",
        "width": 1100,
        "height": 720,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [],
    "category": "Game",
    "shortDescription": "Launcher Minecraft indépendant",
    "longDescription": "Launcher Minecraft gratuit, non affilié à Mojang ni à Microsoft. Minecraft est une marque déposée de Mojang Synergies AB."
  }
}
