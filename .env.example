# Copier ce fichier en .env (non versionné) et renseigner les valeurs.
# Les variables MS_* sont lues à la compilation : MS_CLIENT_ID=... npm run tauri build

# Identifiant de l'application enregistrée dans Microsoft Entra (obligatoire pour la connexion)
MS_CLIENT_ID=

# Clé API CurseForge (optionnelle, nécessite une autorisation)
CURSEFORGE_API_KEY=
